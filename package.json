{
  "name": "domo_front",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test tests/*.test.cjs",
    "desktop:prepare": "node desktop/prepare.cjs",
    "desktop:dev": "electron .desktop-app",
    "desktop:package": "electron-builder --config desktop/builder.cjs --publish never",
